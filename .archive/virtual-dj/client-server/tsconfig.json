{
   "$schema": "https://json.schemastore.org/tsconfig",
   "compilerOptions": {
      "allowSyntheticDefaultImports": true,
      "esModuleInterop": true,
      "isolatedModules": true,
      "lib": ["esnext"],
      "module": "esnext",
      "moduleResolution": "bundler",
      "paths": {
         "@client-server/*": ["./src/*"]
      },
      "preserveWatchOutput": true,
      "resolveJsonModule": true,
      "skipLibCheck": true,
      "strict": true,
      "target": "esnext",
      "types": ["node"]
   }
}

{
   "compilerOptions": {
      "types": ["node"],
      "target": "esnext",
      "lib": ["esnext"],
      "allowJs": true,
      "skipLibCheck": true,
      "strict": true,
      "noEmit": true,
      "esModuleInterop": true,
      "module": "esnext",
      "moduleResolution": "bundler",
      "resolveJsonModule": true
   },
   "exclude": ["node_modules"]
}
